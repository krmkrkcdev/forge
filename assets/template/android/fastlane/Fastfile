default_platform(:android)

# Yol __dir__'e (bu dosyanın klasörü, android/fastlane) göre mutlaklaştırılır.
# Göreli yazmak tuzaktır: fastlane lane gövdesini ve before_all'u
# android/fastlane/ içinde, eylemleri (upload_to_play_store) ise android/
# içinde çalıştırır. Aynı "../build/..." biri için android/build'e, öteki
# için Flutter kökündeki build'e çıkar ve "App Bundle bulunamadı" denetimi
# paket yerindeyken bile her çalıştırmada düşer.
AAB_PATH = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__).freeze

# Testçilerin aldığı kanal: Play Console'da "Kapalı test - Alpha", API'deki
# kimliği `alpha`. `beta` DEĞİL: `beta` AÇIK test kanalıdır, mağaza
# sayfasından herkes katılabilir. Kişisel geliştirici hesabının üretime
# çıkmak için istediği "12 testçi, 14 gün" şartı da yalnızca kapalı testi
# sayar. Lane adı `beta` kalır: deploy.sh'ın iOS ile ortak sözlüğü
# (`beta` = testçilere, `release` = mağazaya), Play kanalıyla ilgisi yok.
TEST_TRACK = "alpha".freeze

platform :android do

  before_all do
    unless File.exist?(AAB_PATH)
      UI.user_error!("App Bundle bulunamadı: #{AAB_PATH}\nÖnce `flutter build appbundle --release` çalıştırın (deploy.sh bunu yapar).")
    end
  end

  desc "Sürüm notlarını fastlane/release_notes.txt dosyasından oku (yoksa varsayılan metin)"
  private_lane :write_changelog do
    notes_path = File.join(Dir.pwd, "release_notes.txt")
    next unless File.exist?(notes_path)

    # supply, notları metadata/android/<dil>/changelogs/<versionCode>.txt yolundan okur.
    lang = ENV["PLAY_STORE_LANG"] || "tr-TR"
    version_code = ENV["DEPLOY_BUILD_NUMBER"]
    next if version_code.to_s.empty?

    dir = File.join(Dir.pwd, "metadata", "android", lang, "changelogs")
    FileUtils.mkdir_p(dir)
    FileUtils.cp(notes_path, File.join(dir, "#{version_code}.txt"))
    UI.message("Sürüm notu hazırlandı: #{lang}/changelogs/#{version_code}.txt")
  end

  desc "Kapalı test (Alpha) kanalına yükle — Play incelemesinden sonra testçilere gider"
  lane :beta do
    write_changelog

    if ENV["DEPLOY_DRY_RUN"] == "true"
      UI.important("DRY-RUN: App Bundle hazır, Play Store'a yükleme atlandı (kanal: #{TEST_TRACK}).")
      next
    end

    upload_to_play_store(
      track: TEST_TRACK,
      aab: AAB_PATH,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end

  desc "Play Store Production'a TASLAK yükle (yayınlamayı insan yapar)"
  lane :release do
    write_changelog

    if ENV["DEPLOY_DRY_RUN"] == "true"
      UI.important("DRY-RUN: App Bundle hazır, Play Store'a yükleme atlandı.")
      next
    end

    # release_status: "draft" — App Bundle Production kanalına TASLAK olarak
    # yüklenir ama YAYINLANMAZ. Bilinçli: kademeli dağıtım yüzdesini seçmek ve
    # "Yayınla"ya basmak, listelemeyi gözden geçirmiş bir insanın işidir.
    # Play Console → Production → taslak sürümü açıp yayınlarsınız.
    #
    # Not: uygulamanın Play Console'da ZATEN oluşturulmuş olması gerekir;
    # bu lane uygulamayı oluşturmaz, yalnızca App Bundle yükler.
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
    UI.success("App Bundle taslak olarak yüklendi. Play Console'da " \
               "yayını siz başlatın.")
  end

end
