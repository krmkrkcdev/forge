# Bu dosyayı ".env" olarak kopyalayın. backend/.env git'e GİRMEZ.
#   cp .env.example .env
#
# Panelin "Sunucuya kur" düğmesi bu dosyayı sunucuda yoksa kendisi üretir ve
# parolayı bir kez rastgele yazar; VARSA dokunmaz.

# Zorunlu. Elle üretmek için:  openssl rand -base64 24
#
# DİKKAT: Yığın bir kez ayağa kalktıktan SONRA bu değeri değiştirmeyin.
# Postgres ilk kurulumdaki parolayı veri dizinine yazar ve sonradan değişen
# POSTGRES_PASSWORD'u yok sayar; sonuç, API'nin "password authentication
# failed" ile restart döngüsüne girmesi ve vekilin 502 döndürmesidir.
# Parolayı gerçekten değiştirmeniz gerekirse veritabanını sıfırlayın:
#   docker compose down -v && docker compose up -d --build
POSTGRES_PASSWORD=

POSTGRES_USER={{PROJECT_NAME}}
POSTGRES_DB={{PROJECT_NAME}}

# API'nin SUNUCUDA localhost'ta dinlediği port — yalnızca yerel doğrulama
# içindir (curl 127.0.0.1:PORT/health). Ters vekil konteynere adıyla
# bağlandığı için bu portu görmez.
#
# Aynı sunucudaki her servise AYRI port verin; iki yığın aynı portu isterse
# ikincisi "address already in use" ile hiç başlamaz.
API_PORT=8000

# Ters vekil ile ortak docker ağı. Sunucuda önceden var olmalıdır.
PROXY_NETWORK=proxy-network

# Yalnızca sunucuyu docker DIŞINDA çalıştırırken gerekir; compose kendi
# DATABASE_URL'ini api servisine geçirir.
# DATABASE_URL=postgresql+asyncpg://{{PROJECT_NAME}}:parola@localhost:5432/{{PROJECT_NAME}}
