# Bu dosyayı ".env" olarak kopyalayıp doldurun. backend/.env git'e GİRMEZ.
#
# Yerelde docker-compose kullanıyorsanız bu değerlere dokunmanıza gerek yok;
# compose kendi DATABASE_URL'ini api servisine geçirir. Bu dosya, sunucuyu
# docker dışında (ör. üretim) çalıştırırken kullanılır.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{PROJECT_NAME}}
